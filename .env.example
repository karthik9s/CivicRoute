# --- Vector store -----------------------------------------------------------
# Postgres + pgvector (docker compose up -d). Leave empty to use the local file index.
DATABASE_URL=postgresql://civicroute:civicroute@localhost:5433/civicroute
VECTOR_STORE=auto            # auto | pgvector | memory

# --- Embeddings -------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # or "hash" for tests
RERANKER_MODEL=                                  # optional, e.g. BAAI/bge-reranker-base

# --- LLM (set ONE key; with none, answers are extractive quotes) -------------
# Free option: Groq (https://console.groq.com/keys) - no card, rate-limited free tier.
LLM_PROVIDER=auto            # auto | groq | anthropic | xai | gemini | openai | none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
XAI_API_KEY=                 # xAI Grok (paid per token)
XAI_MODEL=grok-4.3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
